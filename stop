#!/bin/bash
# Developed with ChatGPT / Codex AI assistance, directed by dadtrick.
# See AI_DISCLOSURE.md at the repository root for attribution and test limits.
set -u

ROOT="$(cd "$(dirname "$0")" && pwd -P)"
QMP="$ROOT/run/bliss-qmp.sock"
DISK="$ROOT/disks/bliss-system.qcow2"
ADB="$ROOT/tools/platform-tools/adb"
CONFIG="$ROOT/config/settings.conf"
ADB_PORT=4444
ENABLE_ADB=1
[ -f "$CONFIG" ] && . "$CONFIG"

fail() {
    echo "$*" >&2
    exit 1
}

is_running() {
    pgrep -af '[q]emu-system-x86_64' 2>/dev/null | grep -F "$DISK" >/dev/null
}

power_menu() {
    [ -S "$QMP" ] || {
        echo "QMP socket unavailable." >&2
        return 1
    }
    python3 - "$QMP" <<'PY'
import json
import socket
import sys


def receive_message(stream):
    line = stream.readline()
    if not line:
        raise RuntimeError("QMP connection closed")
    return json.loads(line)

try:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(3)
        connection.connect(sys.argv[1])
        with connection.makefile("r", encoding="utf-8") as stream:
            if "QMP" not in receive_message(stream):
                raise RuntimeError("Missing QMP greeting")
            for command in ("qmp_capabilities", "system_powerdown"):
                request = {"execute": command, "id": command}
                connection.sendall((json.dumps(request) + "\r\n").encode())
                while True:
                    response = receive_message(stream)
                    # Ignore asynchronous events until this command is acknowledged.
                    if response.get("id") == command:
                        if "error" in response:
                            raise RuntimeError(str(response["error"]))
                        if "return" not in response:
                            raise RuntimeError("Invalid QMP response")
                        break
except (OSError, ValueError, RuntimeError) as error:
    print(f"Power-menu request failed: {error}", file=sys.stderr)
    sys.exit(1)
PY
}

case "${1:-}" in
    --power-menu)
        is_running || fail "BlissOScera is not running."
        power_menu || exit 1
        echo "Android power menu requested; select Power off in Android."
        exit 0
        ;;
    ""|--shutdown)
        ;;
    *)
        echo "Usage: $0 [--shutdown|--power-menu]" >&2
        exit 2
        ;;
esac

# On the tested Android guest, ACPI opens a menu instead of shutting down.
# Use ADB for unattended power-off; retain QMP as the interactive fallback.
is_running || fail "BlissOScera is not running."
[ "$ENABLE_ADB" = 1 ] || fail "ADB is disabled; use --power-menu for interactive shutdown."
[ -x "$ADB" ] || fail "ADB unavailable; use --power-menu for interactive shutdown."

# The device may be offline after a previous power-menu request.
"$ADB" connect "127.0.0.1:$ADB_PORT" >/dev/null 2>&1 || true
ADB_STATE="$("$ADB" -s "127.0.0.1:$ADB_PORT" get-state 2>/dev/null || true)"
[ "$ADB_STATE" = device ] || fail "Android ADB is not ready ($ADB_STATE); use --power-menu."

# ADB may disconnect before acknowledging the shutdown; process exit is authoritative.
"$ADB" -s "127.0.0.1:$ADB_PORT" shell reboot -p >/dev/null 2>&1 || true
for ((attempt = 0; attempt < 60; attempt++)); do
    if ! is_running; then
        echo "BlissOScera shut down successfully."
        exit 0
    fi
    sleep 2
done
fail "Shutdown not confirmed after 120 seconds. VM is still running; use --power-menu or investigate."

